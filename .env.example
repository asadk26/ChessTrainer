# Chess Coach — optional LLM coaching voice.
# Without any of these, the app still works: Stockfish + deterministic coaching templates.
# Keys are read ONLY by the local Vite dev/preview server (never bundled into the browser).

# Option A: Anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-5-5

# Option B: any OpenAI-compatible chat-completions endpoint (OpenAI, OpenRouter, Ollama, LM Studio, ...)
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Force a provider if both are configured: anthropic | openai | none
# COACH_LLM_PROVIDER=anthropic
